{
  "//": "PLANTILLA. Copiar como appsettings.Development.json (ese archivo esta en .gitignore) y completar la clave de firma.",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Jwt": {
    "//": "Clave de firma HS256. Minimo 32 bytes: con una clave mas corta la API se niega a arrancar y explica por que. Generar una propia, por ejemplo con:",
    "//generar": "powershell -c \"[Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))\"",
    "//produccion": "En el server se pasa por la variable de entorno PREDICTIT_JWT_CLAVE y esta seccion no se usa.",
    "Clave": "REEMPLAZAR-POR-UNA-CLAVE-DE-AL-MENOS-32-CARACTERES"
  },

  "Cifrado": {
    "//": "Clave AES-256 para el cifrado reversible (CU.Arq.006). Exactamente 32 bytes en Base64. Sin esta clave el sistema no guarda credenciales: las rechaza en vez de dejarlas en claro.",
    "//generar": "powershell -c \"[Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))\"",
    "//produccion": "En el server se pasa por PREDICTIT_CLAVE_CIFRADO.",
    "//rotacion": "Si se cambia esta clave, lo cifrado con la anterior deja de poder descifrarse y hay que volver a cargarlo.",
    "Clave": "REEMPLAZAR-POR-UNA-CLAVE-AES-256-EN-BASE64"
  },

  "Cors": {
    "//": "Origen del frontend en desarrollo (Vite).",
    "Origenes": [ "http://localhost:5173" ]
  }
}
