# PLANTILLA. Copiar como `.env` —que está en .gitignore— y generar las claves.
#
#   cp .env.ejemplo .env
#
# Generar las dos claves (PowerShell):
#   [Convert]::ToBase64String((1..48 | %{ Get-Random -Max 256 }))   # firma JWT
#   [Convert]::ToBase64String((1..32 | %{ Get-Random -Max 256 }))   # cifrado
#
# Son dos claves distintas a propósito: quien pueda firmar tokens no tiene por
# qué poder leer las credenciales de los clientes.

# Contraseña de sa del contenedor de SQL Server. Tiene que cumplir la política
# de complejidad de SQL Server o el contenedor no arranca.
MSSQL_SA_PASSWORD=PredictIT_2026!

# Contraseña del usuario con el que se conecta la aplicación. La crea el
# script db/06-usuario-de-aplicacion.sql. Tiene que cumplir la política de
# complejidad de SQL Server. No es la de sa a propósito: la aplicación no
# entra como administrador del motor.
PREDICTIT_DB_PASSWORD=REEMPLAZAR-POR-UNA-CONTRASENA-FUERTE-Aa1!

# Firma de los tokens (HS256). Mínimo 32 bytes: con una clave más corta la API
# se niega a arrancar y explica por qué.
PREDICTIT_JWT_CLAVE=REEMPLAZAR-POR-UNA-CLAVE-DE-AL-MENOS-32-CARACTERES

# Cifrado reversible AES-256 (CU.Arq.006). Exactamente 32 bytes en Base64.
# Si se cambia, lo cifrado con la anterior deja de poder descifrarse y hay que
# volver a cargarlo.
PREDICTIT_CLAVE_CIFRADO=REEMPLAZAR-POR-UNA-CLAVE-AES-256-EN-BASE64

# Cada cuántas horas corre el barrido predictivo, y cuánto espera antes del
# primero. Con 0 horas no corre.
PREDICTIT_HORAS_BARRIDO=24
PREDICTIT_MINUTOS_BARRIDO=2

# Fuerza que el proveedor de IA simulado falle 1 de cada N llamadas. Con 1 falla
# siempre, que es la demostración del CP-14 (caída del servicio de IA). Con 0
# nunca falla.
PREDICTIT_IA_FALLAR_CADA=0

# Token para recolectar las metricas en /api/metricas (ADR 0015). Si se deja
# vacio, el endpoint no se expone: las metricas dicen que rutas existen y cuanto
# tarda cada una, asi que abrirlas sin querer es regalar reconocimiento.
# Cualquier cadena larga sirve; va en la cabecera X-Metricas-Token.
PREDICTIT_METRICAS_TOKEN=

# Clave de la API de Anthropic. Opcional: sin ella el sistema usa el proveedor
# simulado y lo deja registrado en la bitácora. Cada organización puede además
# cargar la suya desde la aplicación, y esa gana sobre esta.
ANTHROPIC_API_KEY=

# Huso horario de los contenedores. Sin esto corren en UTC y el sistema sella la
# bitacora y calcula el SLA de 4 horas con tres horas de corrimiento.
TZ=America/Argentina/Buenos_Aires
